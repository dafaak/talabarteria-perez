---
interface Props {
  variant?: "default" | "accent" | "outline";

  size?: "sm" | "md";

  class?: string;
}

const {
  variant = "default",
  size = "md",
  class: className,
} = Astro.props;


const variants = {
  default:
    "bg-[var(--primary)] text-white",

  accent:
    "bg-[var(--accent)] text-[var(--foreground)]",

  outline:
    "border border-[var(--primary)] text-[var(--primary)]",
};


const sizes = {
  sm:
    "px-2 py-1 text-xs",

  md:
    "px-3 py-1.5 text-sm",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full font-medium",
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</span>