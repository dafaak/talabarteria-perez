---
interface Props {
  id?: string;

  spacing?: "sm" | "md" | "lg" | "xl";

  variant?: "default" | "surface" | "accent";

  class?: string;
}

const {
  id,
  spacing = "lg",
  variant = "default",
  class: className,
} = Astro.props;


const spacings = {
  sm: "py-8",
  md: "py-12",
  lg: "py-20",
  xl: "py-32",
};


const variants = {
  default: "bg-[var(--background)]",

  surface: "bg-[var(--surface)]",

  accent: "bg-[var(--accent)]",
};
---

<section
  id={id}
  class:list={[
    spacings[spacing],
    variants[variant],
    className,
  ]}
>
  <slot />
</section>