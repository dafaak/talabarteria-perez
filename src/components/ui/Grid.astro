---
interface Props {
  cols?: 1 | 2 | 3 | 4;
  gap?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const {
  cols = 3,
  gap = "md",
  class: className,
} = Astro.props;

const columns = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
  3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
};

const gaps = {
  sm: "gap-4",
  md: "gap-6",
  lg: "gap-8",
  xl: "gap-12",
};
---

<div
  class:list={[
    "grid",
    columns[cols],
    gaps[gap],
    className,
  ]}
>
  <slot />
</div>