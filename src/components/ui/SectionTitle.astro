---
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12 text-center">

    <h2 class="text-4xl font-bold">
        {title}
    </h2>

    {
        subtitle && (
            <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                {subtitle}
            </p>
        )
    }

</div>