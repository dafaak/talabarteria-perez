---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;

  size?: 
    | "display"
    | "xl"
    | "lg"
    | "md"
    | "sm";

  align?: "left" | "center" | "right";

  class?: string;
  tone?: "default" | "light";
}

const {
  level = 2,
  size = "lg",
  align = "left",
  class: className,
    tone = "default",
} = Astro.props;

const tones = {
  default: "text-[var(--foreground)]",
  light: "text-white",
};

const sizes = {
  display: "text-5xl md:text-7xl",

  xl: "text-4xl md:text-5xl",

  lg: "text-3xl md:text-4xl",

  md: "text-2xl md:text-3xl",

  sm: "text-xl md:text-2xl",
};


const alignments = {
  left: "text-left",

  center: "text-center",

  right: "text-right",
};


const classes = [
  "font-bold",
  "tracking-tight",
  "leading-tight",
  sizes[size],
  alignments[align],
  className,
];

const Tag = `h${level}`;
---

<Tag class:list={classes}>
  <slot />
</Tag>