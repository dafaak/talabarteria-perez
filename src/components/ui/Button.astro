---
interface Props {
    href?: string;
    variant?: "primary" | "secondary";
}

const {
    href,
    variant = "primary"
} = Astro.props;

const classes = {
    primary:
        "bg-[var(--color-primary)] text-white hover:opacity-90",

    secondary:
        "border border-[var(--color-primary)] text-[var(--color-primary)]"
};
---

<a
    href={href}
    class={`inline-flex items-center rounded-xl px-6 py-3 transition ${classes[variant]}`}
>
    <slot />
</a>