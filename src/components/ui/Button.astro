---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  target?: "_self" | "_blank";
  rel?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  target,
  rel,
  type = "button",
  disabled = false,
  class: className,
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel}
      aria-disabled={disabled}
      class:list={[
        "btn",
        `btn-${variant}`,
        `btn-${size}`,
        className,
      ]}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class:list={[
        "btn",
        `btn-${variant}`,
        `btn-${size}`,
        className,
      ]}
    >
      <slot />
    </button>
  )
}