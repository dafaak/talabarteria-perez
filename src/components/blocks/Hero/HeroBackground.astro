---
import Container from "../../ui/Container.astro";
import Stack from "../../ui/Stack.astro";
import Heading from "../../ui/Heading.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import Badge from "../../ui/Badge.astro";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;

  badge?: string;

  title: string;

  description?: string;

  actionText?: string;

  actionHref?: string;
}


const {
  image,
  badge,
  title,
  description,
  actionText,
  actionHref = "#",
} = Astro.props;
---

<section
  class="
    relative
    min-h-[80vh]
    overflow-hidden
    flex
    items-center
  "
>

  <!-- Background image -->
  <img
  src={image.src}
  alt=""
  width={image.width}
  height={image.height}
  class="
    absolute
    inset-0
    h-full
    w-full
    object-cover
  "
/>


  <!-- Overlay -->
  <div
    class="
      absolute
      inset-0
      bg-black/40
    "
  ></div>


  <!-- Content -->
  <Container class="z-50  mx-auto flex flex-col items-center text-center">

    <Stack
      gap="lg"
      class="max-w-2xl "
    >

      {
        badge && (
          <Badge variant="accent" class="flex  flex-col items-center">
            {badge}
          </Badge>
        )
      }


      <Heading
        level={1}
        size="display"
        align="center"
        class="text-white"
      >
        {title}
      </Heading>


      {
        description && (
          <Text
            size="lg"
             tone="light"
          >
            {description}
          </Text>
        )
      }


      {
        actionText && (
          <Button href={actionHref}>
            {actionText}
          </Button>
        )
      }


    </Stack>

  </Container>

</section>