---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Stack from "../ui/Stack.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";

import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<Section id="gallery" spacing="xl" class="scroll-mt-24">
  <Container>
    <!-- Heading -->

    <Stack gap="md" class="max-w-2xl">
      <p
        class="text-sm font-medium tracking-[0.2em] text-[var(--color-accent)] uppercase"
      >
        Galería
      </p>

      <Heading level={2} size="xl"> El trabajo habla por sí mismo. </Heading>

      <Text color="muted">
        Una selección de piezas y trabajos realizados en el taller, donde cada
        detalle refleja el cuidado por el oficio y el trabajo artesanal.
      </Text>
    </Stack>

    <!-- Gallery -->

    <div class="mt-14 grid gap-4 md:grid-cols-3 md:grid-rows-2">
      {
        items.map((item, index) => (
          <div
            class={`group overflow-hidden ${index === 0 ? "md:col-span-2 md:row-span-2" : ""} `}
          >
            <img
              src={item.image.src}
              alt={item.alt}
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
              class="h-full min-h-64 w-full rounded-l  transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        ))
      }
    </div>
  </Container>
</Section>
