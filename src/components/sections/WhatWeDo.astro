---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Stack from "../ui/Stack.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import Button from "../ui/Button.astro";

import type { ImageMetadata } from "astro";

interface Category {
  title: string;
  description: string;
  image: ImageMetadata;
  href: string;
  action: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<Section id="products" spacing="xl">

  <Container>

    <!-- Section heading -->

    <Stack
      gap="md"
      class="max-w-2xl"
    >

      <p
        class="
          text-sm
          font-medium
          uppercase
          tracking-[0.2em]
          text-[var(--color-accent)]
        "
      >
        Lo que hacemos
      </p>

      <Heading
        level={2}
        size="xl"
      >
        Artesanía en cuero, hecha para durar.
      </Heading>

      <Text color="muted">
        Desde el equipamiento ecuestre tradicional hasta
        artículos de cuero y piezas personalizadas, cada
        trabajo recibe la misma atención por los detalles.
      </Text>

    </Stack>


    <!-- Categories -->

    <div class="mt-14 grid gap-8 md:grid-cols-3">

      {
        categories.map((category) => (

          <article class="group">

            <a
              href={category.href}
              class="block"
            >

              <div class="overflow-hidden rounded-2xl">

                <img
                  src={category.image.src}
                  alt=""
                  width={category.image.width}
                  height={category.image.height}
                  class="
                    aspect-[4/5]
                    w-full
                    object-cover
                    transition-transform
                    duration-700
                    group-hover:scale-105
                  "
                />

              </div>


              <div class="mt-6">

                <h3
                  class="
                    font-serif
                    text-2xl
                    text-[var(--color-primary)]
                  "
                >
                  {category.title}
                </h3>

                <p
                  class="
                    mt-3
                    leading-relaxed
                    text-[var(--color-muted)]
                  "
                >
                  {category.description}
                </p>

                <span
                  class="
                    mt-5
                    inline-flex
                    items-center
                    text-sm
                    font-medium
                    text-[var(--color-primary)]
                  "
                >
                  {category.action}
                  <span class="ml-2">→</span>
                </span>

              </div>

            </a>

          </article>

        ))
      }

    </div>

  </Container>

</Section>