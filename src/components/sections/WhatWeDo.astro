---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Stack from "../ui/Stack.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import Button from "../ui/Button.astro";

import type { ImageMetadata } from "astro";

interface Category {
  title: string;
  description: string;
  image: ImageMetadata;
  href: string;
  action: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<Section
  id="what-we-do"
  spacing="xl"
  class="scroll-mt-24"
>
  <Container>

    <!-- Section heading -->

    <Stack
      gap="md"
      class="max-w-2xl"
    >
      <p
        class="
          text-sm
          font-medium
          uppercase
          tracking-[0.2em]
          text-[var(--color-accent)]
        "
      >
        Lo que hacemos
      </p>

      <Heading
        level={2}
        size="xl"
      >
        El cuero puede tomar muchas formas.
      </Heading>

      <Text
        color="muted"
        size="lg"
      >
        Nuestro oficio comenzó con la talabartería,
        pero con los años el trabajo se ha extendido
        a distintos tipos de piezas y encargos.
      </Text>
    </Stack>


    <!-- Categories -->

    <div class="mt-14 grid gap-10 md:grid-cols-3">

      {
        categories.map((category) => (
          <article class="group">

            <!-- Image -->

            <div
              class="
                overflow-hidden
                rounded-[var(--radius)]
              "
            >
              <img
                src={category.image.src}
                alt={category.title}
                width={category.image.width}
                height={category.image.height}
                loading="lazy"
                class="
                  aspect-[4/5]
                  w-full
                  object-cover
                  transition-transform
                  duration-700
                  group-hover:scale-105
                "
              />
            </div>


            <!-- Content -->

            <div class="mt-6">

              <h3
                class="
                  font-serif
                  text-2xl
                  text-[var(--color-primary)]
                "
              >
                {category.title}
              </h3>

              <p
                class="
                  mt-3
                  leading-relaxed
                  text-[var(--color-muted)]
                "
              >
                {category.description}
              </p>


              <!-- Action -->

              <div class="mt-5">

                <Button
                  href={category.href}
                  variant="outline"
                  size="sm"
                  class="rounded-sm"
                >
                  {category.action}
                </Button>

              </div>

            </div>

          </article>
        ))
      }

    </div>

  </Container>
</Section>