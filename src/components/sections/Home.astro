---
const whatsapp = "https://wa.me/593XXXXXXXXX";
---

<section class="relative overflow-hidden bg-stone-950 text-white">
  <div class="mx-auto grid min-h-[85vh] max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-8">

    <div>

      <p class="mb-4 uppercase tracking-[0.3em] text-amber-400">
        Handcrafted in Ecuador
      </p>

      <h1 class="text-5xl font-bold leading-tight lg:text-7xl">
        Premium Leather Saddles
      </h1>

      <p class="mt-8 max-w-xl text-lg text-stone-300">
        Traditional craftsmanship combined with premium leather to create equipment
        built for riders who value quality.
      </p>

      <div class="mt-10 flex gap-4">

        <a
          href="#products"
          class="rounded-lg bg-amber-700 px-6 py-3 transition hover:bg-amber-800"
        >
          View Products
        </a>

        <a
          href={whatsapp}
          class="rounded-lg border border-white px-6 py-3 transition hover:bg-white hover:text-black"
        >
          Contact Us
        </a>

      </div>

    </div>

    <div class="flex justify-center">

      <div class="aspect-square w-full max-w-lg rounded-3xl bg-stone-800">
        <!-- Aquí pondremos la fotografía -->
      </div>

    </div>

  </div>
</section>