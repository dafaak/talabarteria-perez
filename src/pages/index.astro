import WhatWeDo from "../components/sections/WhatWeDo.astro";
import equipmentImage from "../assets/images/equipment.jpg";
import leatherImage from "../assets/images/leather-goods.jpg";
import customImage from "../assets/images/custom.jpg";

import Gallery from "../components/sections/Gallery.astro";

import gallery01 from "../assets/images/gallery-01.jpg";
import gallery02 from "../assets/images/gallery-02.jpg";
import gallery03 from "../assets/images/gallery-03.jpg";
import gallery04 from "../assets/images/gallery-04.jpg";
import gallery05 from "../assets/images/gallery-05.jpg";

import Contact from "../components/sections/Contact.astro";
