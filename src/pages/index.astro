import Home from "../components/sections/Home.astro";

import "../styles/global.css";
import HeroCentered from "../components/blocks/Hero/HeroCentered.astro";
import HeroBackground from "../components/blocks/Hero/HeroBackground.astro";

import HeroSplit from "../components/blocks/Hero/HeroSplit.astro";
import heroImage from "../assets/images/hero-saddle.jpg";

import OurStory from "../components/sections/OurStory.astro";
import storyImage from "../assets/images/workshop.jpg";

import WhatWeDo from "../components/sections/WhatWeDo.astro";
import equipmentImage from "../assets/images/equipment.jpg";
import leatherImage from "../assets/images/leather-goods.jpg";
import customImage from "../assets/images/custom.jpg";
---

<DefaultLayout
  title="Talabartería Perez"
