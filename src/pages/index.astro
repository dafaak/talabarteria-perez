<HeroSplit
  image={heroImage}

  title="Artesanía en cuero hecha a mano."
   description={`Nuestra tradición en la talabartería nos permite crear piezas de cuero pensadas para durar.

Equipamiento ecuestre · Accesorios · Artículos de cuero · Piezas personalizadas`}
  actionText="Nuestros productos"
  actionHref="/productos"
/>

<OurStory
  image={storyImage}
/>

<WhatWeDo
  categories={[
    {
      title: "Equipamiento ecuestre",
      description:
        "Monturas, cabezadas y otros artículos elaborados para el trabajo y la vida a caballo.",
      image: equipmentImage,
      href: "#",
      action: "Ver equipamiento",
    },
    {
      title: "Artículos de cuero",
      description:
        "Piezas de cuero pensadas para acompañar la vida cotidiana con carácter y durabilidad.",
      image: leatherImage,
      href: "#",
      action: "Ver artículos",
    },
    {
      title: "Trabajos personalizados",
      description:
        "Piezas elaboradas según las necesidades y preferencias de cada cliente.",
      image: customImage,
      href: "#",
      action: "Consultar",
    },
  ]}
/>

<Footer/>
</DefaultLayout>
